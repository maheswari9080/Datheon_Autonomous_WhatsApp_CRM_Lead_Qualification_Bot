# ==============================================================================
# Datheon Autonomous WhatsApp CRM Lead Qualification Bot - Environment Template
# ==============================================================================

# Application
APP_NAME="Datheon WhatsApp Sales Intelligence"
APP_ENV="development" # development | testing | production
DEBUG=false
LOG_LEVEL="INFO"
ADMIN_API_KEY="replace-with-secure-admin-token"

# Database Connection (Async SQLAlchemy)
# Local SQLite default:
DATABASE_URL="sqlite+aiosqlite:///./app.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/datheon_db"
DB_ECHO=false

# Meta WhatsApp Cloud API Credentials
META_VERIFY_TOKEN="your_custom_webhook_verify_token"
META_APP_SECRET="your_meta_app_secret_for_hmac_sha256"
META_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
META_ACCESS_TOKEN="your_meta_system_user_access_token"
META_API_VERSION="v21.0"

# AI / LLM Configuration
LLM_PROVIDER="mock" # mock | openai | ollama
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
LLM_TIMEOUT_SECONDS=8.0
MIN_QUALIFICATION_BUDGET=1000.0
QUALIFICATION_CONFIDENCE_THRESHOLD=0.70

# Calendar Provider Configuration
CALENDAR_PROVIDER="mock" # mock | google | calcom
GOOGLE_CALENDAR_ID="primary"
GOOGLE_SERVICE_ACCOUNT_JSON=""
CALCOM_API_KEY="cal_live_placeholder"
CALCOM_EVENT_TYPE_ID=12345
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
DEFAULT_TIMEZONE="UTC"
MEETING_DURATION_MINUTES=30
MIN_NOTICE_HOURS=2

# CRM Provider Configuration
CRM_PROVIDER="mock" # mock | airtable
AIRTABLE_API_KEY="pat_placeholder_key"
AIRTABLE_BASE_ID="app_placeholder_base"
AIRTABLE_TABLE_NAME="Leads"

# Escalation & Alerts
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/PLACEHOLDER/TOKEN"
